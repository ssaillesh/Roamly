# Copy to .env and adjust. Defaults target a native (no-Docker) local setup.
DATABASE_URL=postgresql+psycopg2://saillesh@localhost:5432/sway
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# Geocoding (free, no key required)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=Sway/0.1 (mvp)

ENVIRONMENT=development

# Email via SendGrid Web API (no DNS needed — use Single Sender Verification).
# Leave SENDGRID_API_KEY blank to disable email; password reset then returns
# the token directly in the API response (dev only — see README security note).
SENDGRID_API_KEY=
EMAIL_FROM=                       # a SendGrid-verified sender, e.g. your-name@gmail.com
EMAIL_FROM_NAME=Sway
FRONTEND_BASE_URL=http://127.0.0.1:8080   # where the web UI is hosted (for the reset link)

# --- Planner venue sources -------------------------------------------------
# LLM via any OpenAI-compatible endpoint (Groq / Gemini both have free tiers).
# Blank => the deterministic rule-based planner still works.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# All optional. With none of these set, venues come from OpenStreetMap only.
YELP_API_KEY=
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
