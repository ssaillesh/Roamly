# Copy to .env and adjust. Defaults target a native (no-Docker) local setup.
DATABASE_URL=postgresql+psycopg2://saillesh@localhost:5432/trekrank
REDIS_URL=redis://localhost:6379/0

# Local development only. With ENVIRONMENT=production the API refuses to start
# unless this is set to a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./media
PUBLIC_BASE_URL=http://localhost:8000

# S3 / MinIO (only when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trekrank-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Geocoding (free, no key required)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=TrekRank/0.1 (mvp)

ENVIRONMENT=development

# Email via Resend (resend.com → API Keys). Leave RESEND_API_KEY blank to disable
# email; outside production the reset link is then written to the server log
# instead (never the API response).
RESEND_API_KEY=
# The sender: an address on a domain you've verified in Resend (Resend → Domains),
# e.g. hello@yourdomain.com. Gmail/Outlook addresses can't be used as the sender.
EMAIL_FROM=
EMAIL_FROM_NAME=Roamly
# Where the web UI is hosted: the reset link in emails (<this>/auth?reset_token=…),
# and the origin browsers may call the API from. Production requires the live https site.
FRONTEND_BASE_URL=http://127.0.0.1:8080
# More exact browser origins allowed to call the API, comma-separated (e.g. a www.
# domain). Outside production, localhost / 127.0.0.1 on any port are allowed anyway.
CORS_ALLOW_ORIGINS=

# Rate limiting. Sign-in attempts per 15 min, per account (any capitalisation of the
# email); a successful sign-in clears it.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=10
# How many of your own proxies append to X-Forwarded-For in front of the API (0 =
# ignore the header: clients can write it). Only set it once you've checked your
# host's behaviour; then LOGIN_MAX_ATTEMPTS_PER_IP (0 = off) can limit sign-in
# attempts per address across all accounts.
TRUSTED_PROXY_HOPS=0
LOGIN_MAX_ATTEMPTS_PER_IP=0

# Foursquare Places — free tier; venue popularity = live trendiness signal
FOURSQUARE_API_KEY=


# Admin dashboard — Google Analytics 4 traffic numbers (optional).
# GA4_PROPERTY_ID is the numeric property ID; GA4_CREDENTIALS_JSON is a service
# account's JSON key on one line, and that account needs Viewer on the property.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
# Optional: lets a Prometheus scraper read /metrics with this bearer token.
METRICS_TOKEN=

# Free-tier blocker: never call a metered API past its free allowance (see
# app/services/usage.py). Only set to false once you are ready to pay.
FREE_TIER_ONLY=true
