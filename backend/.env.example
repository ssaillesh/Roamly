# Copy to .env and adjust. Defaults target a native (no-Docker) local setup.
DATABASE_URL=postgresql+psycopg2://saillesh@localhost:5432/trekrank
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./media
PUBLIC_BASE_URL=http://localhost:8000

# S3 / MinIO (only when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trekrank-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Geocoding (free, no key required)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=TrekRank/0.1 (mvp)

ENVIRONMENT=development

# Email via SendGrid Web API (no DNS needed — use Single Sender Verification).
# Leave SENDGRID_API_KEY blank to disable email; password reset then returns
# the token directly in the API response (dev only).
SENDGRID_API_KEY=
EMAIL_FROM=                       # a SendGrid-verified sender, e.g. your-name@gmail.com
EMAIL_FROM_NAME=TrekRank
FRONTEND_BASE_URL=http://127.0.0.1:8080   # where the web UI is hosted (for the reset link)

# Foursquare Places — free tier; venue popularity = live trendiness signal
FOURSQUARE_API_KEY=


# Admin dashboard — Google Analytics 4 traffic numbers (optional).
# GA4_PROPERTY_ID is the numeric property ID; GA4_CREDENTIALS_JSON is a service
# account's JSON key on one line, and that account needs Viewer on the property.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
# Optional: lets a Prometheus scraper read /metrics with this bearer token.
METRICS_TOKEN=

# Free-tier blocker: never call a metered API past its free allowance (see
# app/services/usage.py). Only set to false once you are ready to pay.
FREE_TIER_ONLY=true
