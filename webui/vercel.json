{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/app", "destination": "/rova", "permanent": false },
    { "source": "/roamly", "destination": "/rova", "permanent": true },
    { "source": "/roamly.html", "destination": "/rova", "permanent": true }
  ],
  "rewrites": [
    { "source": "/n/:code", "destination": "/n" }
  ]
}
